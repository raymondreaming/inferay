{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"allowJs": true,
		"types": ["vite/client", "bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"paths": {
			"@contracts": ["./build/presentation/contracts/index.ts"],
			"@app/*": ["./src/app/*"],
			"@agents/*": ["./src/modules/agents/*"],
			"@context/*": ["./src/modules/context/*"],
			"@conversation/*": ["./src/modules/conversation/*"],
			"@design-system/*": ["./src/design-system/*"],
			"@explorer/*": ["./src/modules/explorer/*"],
			"@onboarding/*": ["./src/modules/onboarding/*"],
			"@repository/*": ["./src/modules/repository/*"],
			"@shared/*": ["./src/shared/*"],
			"@settings/*": ["./src/modules/settings/*"],
			"@skills/*": ["./src/modules/skills/*"],
			"@workspace/*": ["./src/modules/workspace/*"]
		},
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": false,

		// Additional strictness guardrails
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": false,
		"noImplicitReturns": true,
		"noImplicitOverride": true
	},
	"exclude": ["dist", "build", "node_modules", "site", "docs"]
}
