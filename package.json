{
	"name": "agent-gui",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": "1.4.0"
	},
	"scripts": {
		"prepare": "husky",
		"dev": "bash scripts/dev-app.sh",
		"build:native": "cargo build --release -p inferay-desktop",
		"build:renderer": "node node_modules/vite/bin/vite.js build --mode production",
		"build": "bash scripts/build-rust-app.sh",
		"start": "bun run build:renderer && cargo run --release -p inferay-desktop",
		"release": "cargo run -p inferay-tooling -- release",
		"release:resume": "cargo run -p inferay-tooling -- release --resume",
		"format": "bunx biome format --write ./src",
		"check": "bunx biome check --write ./src",
		"code": "bun scripts/count-code.ts",
		"check:components": "bun scripts/check-component-structure.ts",
		"check:architecture": "bash scripts/check-architecture.sh",
		"check:native": "cargo check -p inferay-desktop",
		"check:rust-host": "cargo check -p inferay-desktop"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@babel/parser": "7.29.8",
		"@babel/types": "7.29.8",
		"@biomejs/biome": "^2.5.12",
		"@tailwindcss/vite": "4.3.0",
		"@types/bun": "latest",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@octanejs/stylex": "0.1.43",
		"@octanejs/tanstack-query": "0.1.43",
		"@octanejs/tanstack-router": "0.1.43",
		"@octanejs/tanstack-start": "0.1.33",
		"@tanstack/query-core": "5.101.3",
		"@yutengjing/vscode-icons": "0.1.1",
		"border-beam": "^1.3.0",
		"octane": "0.1.44",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"vite": "8.1.5",
		"yaml": "^2.9.0"
	}
}
