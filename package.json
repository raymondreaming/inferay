{
	"name": "agent-gui",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"dev": "bash scripts/electrobun.sh dev",
		"build:native": "bash scripts/build-native.sh",
		"build:renderer": "bun scripts/build-renderer.ts",
		"build": "bun run build:renderer && bun run build:native && bash scripts/electrobun.sh build",
		"start": "bash scripts/electrobun.sh run",
		"test": "bun run test:unit && bun run test:renderer",
		"test:unit": "bun test",
		"test:renderer": "vitest run --config vitest.config.ts",
		"release": "bun scripts/release.ts",
		"release:resume": "bun scripts/release.ts --resume",
		"format": "bunx biome format --write ./src",
		"format:prettier": "prettier . --write",
		"check": "bunx biome check --write ./src",
		"check:architecture": "bash scripts/check-architecture.sh"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@octanejs/testing-library": "0.1.14",
		"@tailwindcss/vite": "4.3.0",
		"@types/bun": "latest",
		"@types/jsdom": "^28.0.3",
		"@types/react": "^19.2.14",
		"happy-dom": "20.11.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.2",
		"@octanejs/remix-router": "0.1.13",
		"@octanejs/stylex": "0.1.16",
		"@octanejs/tanstack-virtual": "0.1.14",
		"@octanejs/vite-plugin": "0.1.17",
		"@tanstack/db": "0.6.7",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"electrobun": "^1.18.1",
		"octane": "0.1.17",
		"shiki": "^4.0.2",
		"tailwindcss": "^4.3.0",
		"vite": "8.1.5",
		"yaml": "^2.9.0"
	}
}
