{
	"name": "agent-gui",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.1",
	"engines": {
		"bun": "1.4.1"
	},
	"scripts": {
		"preinstall": "bun scripts/check-bun-version.mjs",
		"prepare": "bun scripts/check-bun-version.mjs && husky",
		"dev": "bash scripts/dev-app.sh",
		"build:native": "bun scripts/check-bun-version.mjs && cargo build --release -p inferay-desktop",
		"build:renderer": "bun scripts/check-bun-version.mjs && bash scripts/sync-file-icons.sh && bun run build:presentation && node node_modules/vite/bin/vite.js build --mode production",
		"build": "bash scripts/build-rust-app.sh",
		"dmg": "bash scripts/build-dmg.sh && open artifacts/inferay-installer.dmg",
		"start": "bun run build:renderer && cargo run --release -p inferay-desktop",
		"release": "cargo run -p inferay-tooling -- release",
		"release:resume": "cargo run -p inferay-tooling -- release --resume",
		"format": "bunx biome format --write ./src",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix --deny-warnings .",
		"check": "bun run lint && bunx biome check ./src",
		"code": "bun scripts/count-code.ts",
		"check:components": "bun scripts/check-component-structure.ts",
		"check:architecture": "bash scripts/check-architecture.sh",
		"check:boundaries": "bun scripts/check-architecture-boundaries.ts",
		"check:native": "cargo check -p inferay-desktop",
		"check:rust-host": "cargo check -p inferay-desktop",
		"build:presentation": "bash scripts/build-presentation.sh",
		"sync:file-icons": "bash scripts/sync-file-icons.sh"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
			"oxlint --deny-warnings --no-error-on-unmatched-pattern",
			"biome check --write --no-errors-on-unmatched"
		],
		"*.{json,css}": "biome check --write --no-errors-on-unmatched"
	},
	"devDependencies": {
		"@babel/core": "^7",
		"@babel/generator": "^7",
		"@babel/parser": "7.29.8",
		"@babel/traverse": "^7",
		"@babel/types": "7.29.8",
		"@biomejs/biome": "^2.5.12",
		"@playwright/test": "^1.63.0",
		"@solidjs/compiler": "2.0.0-rc.6",
		"@solidjs/vite-plugin": "3.0.0-next.39",
		"@stylexjs/unplugin": "0.19.0",
		"@tailwindcss/vite": "4.3.0",
		"@types/bun": "latest",
		"chokidar": "^5.0.0",
		"csstype": "^3.2.3",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxlint": "1.82.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@solidjs/router": "^2.0.0-next.21",
		"@solidjs/web": "2.0.0-rc.6",
		"@stylexjs/stylex": "0.19.0",
		"@tanstack/query-core": "5.101.4",
		"@tanstack/solid-query": "6.0.0-rc.3",
		"@yutengjing/vscode-icons": "0.1.1",
		"mermaid": "^12.0.0",
		"solid-js": "2.0.0-rc.6",
		"tailwindcss": "^4.3.3",
		"vite": "8.1.5",
		"yaml": "^2.9.0"
	}
}
