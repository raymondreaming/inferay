{
	"name": "agent-gui",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": "1.4.4"
	},
	"scripts": {
		"preinstall": "bun scripts/check-bun-version.mjs",
		"prepare": "bun scripts/check-bun-version.mjs && husky",
		"dev": "bash scripts/dev-gpui.sh",
		"dev:gpui": "bash scripts/dev-gpui.sh",
		"build:gpui": "bash scripts/dev-gpui.sh --build-only",
		"build": "bash scripts/build-rust-app.sh",
		"start": "bash scripts/dev-gpui.sh",
		"dmg": "bash scripts/build-dmg.sh",
		"release": "cargo run -p inferay-tooling -- release",
		"release:resume": "cargo run -p inferay-tooling -- release --resume",
		"check": "bash scripts/check-architecture.sh",
		"check:architecture": "bash scripts/check-architecture.sh",
		"check:native": "cargo check --manifest-path native/gpui/Cargo.toml",
		"code": "bun scripts/count-code.ts",
		"generate:api": "cargo run -p inferay-tooling --bin export-api-reference"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
			"oxlint --deny-warnings --no-error-on-unmatched-pattern",
			"biome check --write --no-errors-on-unmatched",
			"bun fmt --no-error-on-unmatched-pattern"
		],
		"*.{json,css}": [
			"biome check --write --no-errors-on-unmatched",
			"bun fmt --no-error-on-unmatched-pattern"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxlint": "1.82.0"
	},
	"dependencies": {}
}
