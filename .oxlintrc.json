{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
		"eslint/no-unused-expressions": [
			"error",
			{ "allowShortCircuit": true, "allowTernary": true }
		]
	},
	"ignorePatterns": [
		"node_modules/**",
		"build/**",
		"dist/**",
		"target/**",
		"coverage/**",
		"public/file-icons/**",
		"site/**",
		"docs/**"
	]
}
