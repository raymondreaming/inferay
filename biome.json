{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/index.template.html",
			"!**/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": false
	},
	"overrides": [
		{
			"includes": ["**/*.css", "**/*.json", "**/*.jsonc"],
			"linter": { "enabled": true }
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
