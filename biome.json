{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/dist"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": false
	},
	"overrides": [
		{
			"includes": ["**/*.css", "**/*.json", "**/*.jsonc"],
			"linter": {
				"enabled": true
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
